APP_NAME="AI Lolos PTN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ailolos_ptn
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ailolosiptn.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Google Gemini (AI Engine) ─────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_MAX_RPM=14

# ── api.co.id — Indonesian University Data ────────────────────
# Get your key at https://api.co.id
APICOIND_KEY=your-apicoind-key-here

# ── logo.dev — Campus Logo Fetching ──────────────────────────
# URL format: https://img.logo.dev/name/{Name}?token={TOKEN}&retina=true
# Get your token at https://logo.dev
LOGODEV_TOKEN=pk_a1dih9BDRCmE0bDH9EgSUg

# ── Midtrans Payment Gateway ──────────────────────────────────
# https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ── Sanctum ───────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000
